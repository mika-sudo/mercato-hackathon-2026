# API origin only. The worker appends endpoint paths.
# Leave empty to run in mock mode.
VITE_API_BASE_URL=

# Optional bearer token used by the background worker.
VITE_API_KEY=

# InboxSDK app id, e.g. sdk_abcde_0123456789
VITE_INBOXSDK_APP_ID=

# Optional: public extension key for stable unpacked extension id.
EXTENSION_PUBLIC_KEY=
